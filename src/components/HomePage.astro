  <script>
    const scrollProgress = document.querySelector("[data-scroll-progress]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const updateScrollProgress = () => {
      if (!scrollProgress) return;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? Math.min(Math.max(window.scrollY / maxScroll, 0), 1) : 0;
      scrollProgress.style.setProperty("--scroll-progress", String(progress));
      scrollProgress.style.transform = `scaleX(${progress})`;
    };

    updateScrollProgress();
    window.addEventListener("scroll", updateScrollProgress, { passive: true });
    window.addEventListener("resize", updateScrollProgress);

    const revealItems = Array.from(document.querySelectorAll("[data-reveal]"));

    if (reduceMotion) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        });
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.16 });

      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }

    // --- Hero Carousel Controller ---
    const carousel = document.querySelector("[data-hero-carousel]");
    const tracks = Array.from(document.querySelectorAll("[data-hero-progress] .progress-track"));
    const slides = carousel ? Array.from(carousel.querySelectorAll(".hero-slide")) : [];
    
    if (slides.length > 0 && tracks.length > 0) {
      let activeIndex = 0;
      let timer = null;
      const slideDuration = 5500; // 5.5s

      const resetTracks = () => {
        tracks.forEach(track => {
          track.classList.remove("is-active", "is-completed");
        });
      };

      const heroContent = document.querySelector(".hero-content");

      const showSlide = (index) => {
        if (activeIndex === index && timer) return;
        
        slides[activeIndex].classList.remove("is-active");
        slides[index].classList.add("is-active");
        
        if (heroContent) {
          heroContent.classList.remove("is-active");
          setTimeout(function() {
            heroContent.classList.add("is-active");
          }, 220);
        }
        
        resetTracks();
        
        for (let i = 0; i < index; i++) {
          tracks[i].classList.add("is-completed");
        }
        
        tracks[index].classList.add("is-active");
        
        activeIndex = index;
        
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => {
          const nextIndex = (activeIndex + 1) % slides.length;
          showSlide(nextIndex);
        }, slideDuration);
      };

      if (heroContent) {
        heroContent.classList.add("is-active");
      }
      tracks[0].classList.add("is-active");
      timer = setTimeout(() => {
        showSlide(1);
      }, slideDuration);

      tracks.forEach((track, index) => {
        track.addEventListener("click", () => {
          showSlide(index);
        });
      });

      // 绑定左右手动切换箭头事件
      const prevBtn = document.getElementById("hero-prev");
      const nextBtn = document.getElementById("hero-next");
      if (prevBtn) {
        prevBtn.addEventListener("click", () => {
          const prevIndex = (activeIndex - 1 + slides.length) % slides.length;
          showSlide(prevIndex);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener("click", () => {
          const nextIndex = (activeIndex + 1) % slides.length;
          showSlide(nextIndex);
        });
      }
    }

    // --- Mobile Navigation Drawer Controller ---
    const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
    const mobileNavPanel = document.getElementById("mobile-nav-panel");
    const header = document.querySelector(".site-header");
    const iconMenu = mobileMenuToggle?.querySelector(".icon-menu");
    const iconClose = mobileMenuToggle?.querySelector(".icon-close");

    if (mobileMenuToggle && mobileNavPanel && header) {
      const toggleMenu = () => {
        const isOpen = header.classList.toggle("menu-open");
        if (iconMenu && iconClose) {
          if (isOpen) {
            iconMenu.style.display = "none";
            iconClose.style.display = "block";
            mobileNavPanel.style.height = `${mobileNavPanel.scrollHeight}px`;
          } else {
            iconMenu.style.display = "block";
            iconClose.style.display = "none";
            mobileNavPanel.style.height = "0";
          }
        }
      };

      mobileMenuToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      // 点击菜单内的链接时自动收起
      const mobileLinks = mobileNavPanel.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          if (header.classList.contains("menu-open")) {
            toggleMenu();
          }
        });
      });

      // 点击页面其它空白区域自动收起
      document.addEventListener("click", (e) => {
        if (header.classList.contains("menu-open") && !header.contains(e.target)) {
          toggleMenu();
        }
      });
    }

    // --- Processing Marquee Controller ---
    const marquee = document.querySelector(".processing-marquee") as HTMLElement | null;
    const marqueeTrack = marquee ? marquee.querySelector(".marquee-track") as HTMLElement | null : null;
    const marqueeSets = marqueeTrack ? marqueeTrack.querySelectorAll(".marquee-set") : [];
    const firstSet = marqueeSets[0] as HTMLElement | null;
    const secondSet = marqueeSets[1] as HTMLElement | null;
    const marqueeSet = firstSet;

    if (marquee && marqueeTrack && marqueeSet) {
      let isDown = false;
      let startX: number;
      let scrollLeftVal: number;
      let animationFrameId: number | null = null;
      let speed = 0.2; // 滚动的基本速度
      let isPaused = false;
      let scrollAccumulator = marquee.scrollLeft;

      // 自动循环滚动函数
      const autoScroll = () => {
        if (!isPaused && !isDown) {
          scrollAccumulator += speed;
          marquee.scrollLeft = scrollAccumulator;
          
          const limit = secondSet ? secondSet.offsetLeft : marqueeSet.offsetWidth;
          
          // 当滚动超过折返点时，瞬间折返回 0
          if (scrollAccumulator >= limit) {
            scrollAccumulator = 0;
            marquee.scrollLeft = 0;
          }
        }
        animationFrameId = requestAnimationFrame(autoScroll);
      };

      // 启动自动滚动
      autoScroll();

      // 鼠标按下：准备拖动
      marquee.addEventListener("mousedown", (e: MouseEvent) => {
        isDown = true;
        isPaused = true; // 拖动时必须暂停自动滚动
        startX = e.pageX - marquee.offsetLeft;
        scrollLeftVal = marquee.scrollLeft;
        scrollAccumulator = marquee.scrollLeft; // 同步累加器
      });

      // 鼠标移出：结束拖动，恢复自动滚动
      marquee.addEventListener("mouseleave", () => {
        if (isDown) {
          isDown = false;
          isPaused = false;
          scrollAccumulator = marquee.scrollLeft; // 同步累加器
        }
      });

      // 鼠标松开：结束拖动，恢复自动滚动
      marquee.addEventListener("mouseup", () => {
        if (isDown) {
          isDown = false;
          isPaused = false;
          scrollAccumulator = marquee.scrollLeft; // 同步累加器
        }
      });

      // 鼠标拖拽平移滚动逻辑
      marquee.addEventListener("mousemove", (e: MouseEvent) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - marquee.offsetLeft;
        const walk = (x - startX) * 1.5; // 位移乘数，决定拖拽的灵敏度
        marquee.scrollLeft = scrollLeftVal - walk;
        scrollAccumulator = marquee.scrollLeft; // 同步累加器

        // 边界循环处理，防止拖拽越界
        const limit = secondSet ? secondSet.offsetLeft : marqueeSet.offsetWidth;
        if (marquee.scrollLeft >= limit) {
          marquee.scrollLeft = 0;
          scrollAccumulator = 0;
          startX = e.pageX - marquee.offsetLeft; // 重新定位坐标系，防止拖拽时跳动
          scrollLeftVal = 0;
        } else if (marquee.scrollLeft <= 0) {
          marquee.scrollLeft = limit;
          scrollAccumulator = limit;
          startX = e.pageX - marquee.offsetLeft;
          scrollLeftVal = limit;
        }
      });

      // 手机端触控：按下（touchstart）时暂停自动滚动，移开（touchend）时恢复自动滚动
      marquee.addEventListener("touchstart", () => {
        isPaused = true;
        scrollAccumulator = marquee.scrollLeft; // 同步累加器
      }, { passive: true });

      marquee.addEventListener("touchend", () => {
        isPaused = false;
        scrollAccumulator = marquee.scrollLeft; // 同步累加器
      }, { passive: true });

      // 原生滚动时进行越界判定
      marquee.addEventListener("scroll", () => {
        scrollAccumulator = marquee.scrollLeft; // 原生滚动时同步累加器
        const limit = secondSet ? secondSet.offsetLeft : marqueeSet.offsetWidth;
        if (marquee.scrollLeft >= limit) {
          marquee.scrollLeft = 0;
          scrollAccumulator = 0;
        } else if (marquee.scrollLeft <= 0) {
          marquee.scrollLeft = limit;
          scrollAccumulator = limit;
        }
      }, { passive: true });
    }
  </script>

